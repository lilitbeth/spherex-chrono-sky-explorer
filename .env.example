# Optional: your free key from https://api.nasa.gov (DEMO_KEY is used otherwise).
# Users can also paste a key in the app (Quick Guide → Settings); it is stored only in their browser.
VITE_NASA_API_KEY=DEMO_KEY

# Supabase (cloud accounts). Public values from Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
